{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:8090"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=zappy-mart.db"
  },
  "Seed": {
    "LoadAtStart": false
  },
  "GraphQL": {
    "Path": "/graphql",
    "ExposeResetSeed": false,
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3001",
      "http://localhost:4200"
    ]
  },
  "Security": {
    "Issuer": "https://zappy-mart.localhost",
    "Audience": "zappy-mart",
    "Argon2MemoryKibibytes": 19456,
    "Argon2Iterations": 2,
    "Argon2Parallelism": 1,
    "LoginAttemptsAllowed": 20,
    "LoginAttemptWindowMinutes": 5
  }
}
